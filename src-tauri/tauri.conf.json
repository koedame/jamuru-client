{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jamuru",
  "version": "0.1.0",
  "identifier": "me.koeda.jamuru",
  "build": {
    "beforeDevCommand": "npm run tauri:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run tauri:build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "jamuru - P2P Audio",
        "width": 600,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 600,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/LICENSES.txt"
    ],
    "licenseFile": "../LICENSE",
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "copyright": "Copyright (c) 2024 koedame. Source Available License.",
    "shortDescription": "Low-latency P2P audio communication for musicians"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "jamuru"
        ]
      }
    }
  }
}
